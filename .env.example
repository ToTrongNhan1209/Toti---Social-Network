# NhimColdly Media Blog – Environment Variables
# ================================================
# COPY this file to .env.local and fill in real values
# DO NOT commit .env.local to git (it is already in .gitignore)

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="NhimColdly Media"

# ── Database (example: PostgreSQL via Supabase) ───────────────────────────
# Rule #3: Force SSL, restrict privileges
# DATABASE_URL="postgresql://user:password@host:5432/nhimcoldly?sslmode=require"
# DATABASE_POOL_SIZE=10

# ── Authentication (example: NextAuth / Auth.js) ──────────────────────────
# NEXTAUTH_SECRET=your-super-secret-32-char-random-string
# NEXTAUTH_URL=http://localhost:3000

# ── Email service (example: Resend) ──────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Rate limiting (example: Upstash Redis) ────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloud Storage (example: Cloudinary) ──────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret     # SERVER-SIDE ONLY

# ── Analytics ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...      # client-safe
# TURNSTILE_SECRET_KEY=0x...               # SERVER-SIDE ONLY, never expose

# ── Google Cloud OAuth 2.0 Credentials ────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ADMIN_AUTH_SECRET=your-secure-random-jwt-secret
# ADMIN_ALLOWED_EMAILS=totrongnhan1209@gmail.com
